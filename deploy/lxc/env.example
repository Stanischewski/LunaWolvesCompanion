# =============================================================================
# Luna Wolves — EINE Konfiguration fuer alle drei Dienste
# =============================================================================
# Nach /opt/lunawolves/.env kopieren und die <...>-Platzhalter ersetzen.
# setup.sh verlinkt apps/{api,bot,web}/.env auf diese Datei, es gibt also
# nur dieses eine File. Das ist der Punkt: BOT_SECRET und DISCORD_BOT_TOKEN
# werden von zwei Diensten gelesen und koennen so nicht auseinanderlaufen.
#
# Kein PORT hier: siehe Kommentar in ecosystem.config.cjs.
# =============================================================================

NODE_ENV=production

# --- PostgreSQL (euer bestehender DB-Container) ------------------------------
# <DB_HOST> ist die IP des DB-Containers, nicht 127.0.0.1.
# Beide Zeilen zeigen auf dieselbe Datenbank, mit unterschiedlichen Rollen:
# lw_admin wandert durch die Migrationen, lw_app betreibt die API.
DATABASE_ADMIN_URL=postgresql://lw_admin:<ADMIN_PASSWORT>@<DB_HOST>:5432/lunawolves
DATABASE_URL=postgresql://lw_app:<APP_PASSWORT>@<DB_HOST>:5432/lunawolves

# --- Oeffentliche URLs -------------------------------------------------------
# WEB_URL ist die CORS-Origin der API (apps/api/src/index.ts:53). Fehlt sie,
# erlaubt die API nur http://localhost:3000 und der Browser blockiert jede
# Anfrage von der echten Domain. Das ist die haeufigste Ursache fuer eine
# Web-App, die eingeloggt aussieht, aber keine Daten zieht.
WEB_URL=https://<DEINE_DOMAIN>

# Ziel der Weiterleitung nach dem OAuth-Durchlauf.
FRONTEND_URL=https://<DEINE_DOMAIN>

# Oeffentliche API-Adresse fuer den Browser (Client Components, Socket.IO).
# ACHTUNG: Next.js backt NEXT_PUBLIC_*-Werte beim BUILD in das Browser-Bundle.
# Wird dieser Wert spaeter geaendert, muss die Web-App neu gebaut werden —
# ein PM2-Restart genuegt nicht.
NEXT_PUBLIC_API_URL=https://<DEINE_DOMAIN>

# Interne Adresse der API. Im Ein-Container-Betrieb bleibt der Verkehr von Bot
# und Web-SSR auf dem Loopback und verlaesst den Container nicht.
API_URL=http://127.0.0.1:3001

# --- Battle.net OAuth2 -------------------------------------------------------
# https://develop.battle.net/access/clients
BNET_CLIENT_ID=<CLIENT_ID>
BNET_CLIENT_SECRET=<CLIENT_SECRET>
BNET_CALLBACK_URL=https://<DEINE_DOMAIN>/auth/bnet/callback
BNET_REGION=eu

# --- Discord OAuth2 + Bot ----------------------------------------------------
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=<CLIENT_ID>
DISCORD_CLIENT_SECRET=<CLIENT_SECRET>
DISCORD_CALLBACK_URL=https://<DEINE_DOMAIN>/auth/discord/callback
DISCORD_BOT_TOKEN=<BOT_TOKEN>
DISCORD_GUILD_ID=<DISCORD_SERVER_ID>

# --- Berechtigungen (beides PFLICHT, die Pruefung ist fail closed) -----------
# Ohne ADMIN_DISCORD_ROLE_ID und ohne in der UI hinterlegte Rollen kann
# niemand DKP buchen oder Einstellungen aendern — auch kein Officer.
ADMIN_DISCORD_ROLE_ID=<ROLLEN_ID>
# Rollen-IDs der Officers, kommagetrennt. Ohne sie sind /dkp award und
# /dkp spend im Bot gesperrt.
OFFICER_ROLE_IDS=<ROLLEN_ID>,<ROLLEN_ID>

# --- Secrets -----------------------------------------------------------------
# Gemeinsames Secret zwischen API und Bot. Wird von beiden gelesen.
#   openssl rand -hex 32
BOT_SECRET=<ZUFALLSSTRING>

# Signiert die Anmelde-Tokens.
#   openssl rand -hex 64
#
# WICHTIG: Diesen Wert bei einem Neuaufbau AUFBEWAHREN. Ein neuer JWT_SECRET
# macht jeden bereits ausgegebenen Token ungueltig — der Desktop-Agent
# antwortet dann mit "401 Nicht authentifiziert" und muss sich neu anmelden.
JWT_SECRET=<ZUFALLSSTRING>

# Verschluesselt die Battle.net-Tokens in der Datenbank.
#   openssl rand -hex 32
# Fehlt der Schluessel, liegen die Tokens im Klartext und die API warnt beim Start.
TOKEN_ENCRYPTION_KEY=<64_HEX_ZEICHEN>

# --- Bot: Gilde und Channels -------------------------------------------------
# UUID der Gilde aus der Datenbank. Die gibt es erst, NACHDEM der erste
# Addon-Sync gelaufen ist — bis dahin leer lassen, setup.sh startet den Bot
# dann noch nicht (er wuerde sonst in einer Neustartschleife haengen).
# Danach auslesen mit:
#   psql "$DATABASE_URL" -tAc "SELECT id, name FROM guilds;"
LUNA_GUILD_ID=

# Rechtsklick auf den Channel -> ID kopieren (Entwicklermodus aktiv). Optional.
RAID_CHANNEL_ID=
OFFICER_CHANNEL_ID=

# --- Web ---------------------------------------------------------------------
# Leer lassen = erste Gilde des eingeloggten Spielers.
GUILD_NAME=<GILDENNAME>

# --- Optional ----------------------------------------------------------------
# Abstand zwischen zwei Addon-Uploads pro Spieler in Millisekunden.
# 0 schaltet die Drossel ab (nur fuer Tests).
SYNC_COOLDOWN_MS=60000

# REDIS_URL bleibt absichtlich leer: Bei einem API-Prozess ist der
# Speicher-Cache gleichwertig. Erst wenn in ecosystem.config.cjs
# instances > 1 steht, wird Redis zur Pflicht — sonst hat jeder Worker
# seinen eigenen Rollen-Cache und seinen eigenen Sync-Cooldown.
# REDIS_URL=redis://127.0.0.1:6379
