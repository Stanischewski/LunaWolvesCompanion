# ============================================================
# Luna Wolves — API Umgebungsvariablen (CT 202)
# Luna Wolves — API Environment Variables (CT 202)
# ============================================================
# Diese Datei nach /opt/lunawolves/apps/api/.env kopieren
# und alle Platzhalter (<...>) durch echte Werte ersetzen.
#
# Copy this file to /opt/lunawolves/apps/api/.env
# and replace all placeholders (<...>) with real values.
# ============================================================

# --- Anwendung / Application ---
NODE_ENV=production
# Kein PORT: die API hoert fest auf 3001 (src/index.ts, app.listen).
# No PORT: the API listens on a fixed 3001.

# --- PostgreSQL (CT 200) ---
# Admin-Verbindung für Migrationen (Drizzle Kit)
# Admin connection for migrations (Drizzle Kit)
DATABASE_ADMIN_URL=postgresql://lw_admin:<PASSWORT>@10.10.10.200:5432/lunawolves
# App-Verbindung für den API-Betrieb
# App connection for the API
DATABASE_URL=postgresql://lw_app:<PASSWORT>@10.10.10.200:5432/lunawolves

# --- Redis (optional) ---
# Gemeinsamer Cache fuer Rollen und Sync-Cooldowns. Ohne die Variable nutzt die
# API einen begrenzten Speicher-Cache — bei EINEM Prozess gleichwertig. Erst ab
# instances > 1 wird Redis zur Pflicht, sonst hat jeder Worker seinen eigenen
# Rollen-Cache und seinen eigenen Cooldown.
#
# Shared cache for roles and sync cooldowns. Only required once more than one
# API process runs.
# REDIS_URL=redis://:<PASSWORT>@10.10.10.201:6379

# --- Battle.net OAuth2 ---
# Zugangsdaten aus: https://develop.battle.net/access/clients
# Credentials from: https://develop.battle.net/access/clients
BNET_CLIENT_ID=<CLIENT_ID>
BNET_CLIENT_SECRET=<CLIENT_SECRET>
BNET_CALLBACK_URL=https://<DEINE_DOMAIN>/auth/bnet/callback
BNET_REGION=eu

# --- Discord OAuth2 & Bot (CT 203) ---
# Zugangsdaten aus: https://discord.com/developers/applications
# Credentials from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=<CLIENT_ID>
DISCORD_CLIENT_SECRET=<CLIENT_SECRET>
DISCORD_CALLBACK_URL=https://<DEINE_DOMAIN>/auth/discord/callback
DISCORD_BOT_TOKEN=<BOT_TOKEN>
DISCORD_GUILD_ID=<SERVER_ID>
# PFLICHT: Discord-Rollen-ID für den ersten Admin (Bootstrap, bevor Settings in
# der UI gesetzt sind). Ohne diese Variable UND ohne in der UI hinterlegte Rollen
# kann niemand DKP buchen oder Einstellungen ändern — die Rechteprüfung ist
# fail closed.
# REQUIRED: Discord role ID for the initial admin (bootstrap, before settings are
# configured in the UI). Without it AND without roles stored in the UI, nobody can
# post DKP or change settings — the permission check is fail closed.
ADMIN_DISCORD_ROLE_ID=<ROLLEN_ID>

# Gemeinsames Secret zwischen API und Bot (beliebiger Zufallsstring)
# Shared secret between API and bot (any random string)
BOT_SECRET=<ZUFALLSSTRING>

# --- Verschlüsselung / Encryption ---
# Schlüssel für die Battle.net-Access-Tokens in der Datenbank (A10).
# Erzeugen mit: openssl rand -hex 32
# Fehlt er, werden die Tokens im Klartext gespeichert und die API warnt beim Start.
# Bestandsdaten im Klartext bleiben lesbar — es braucht keine Migration.
#
# Key for the Battle.net access tokens stored in the database.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=<64_HEX_ZEICHEN>

# Abstand zwischen zwei Addon-Uploads pro Spieler in Millisekunden.
# 0 schaltet den Cooldown ab (nur für Tests/Staging).
# Cooldown between addon uploads per player, in milliseconds. 0 disables it.
SYNC_COOLDOWN_MS=60000

# --- JWT ---
# Lange Zufallsstrings verwenden, z.B.: openssl rand -hex 64
# Use long random strings, e.g.: openssl rand -hex 64
# Bei einem Neuaufbau AUFBEWAHREN: ein neuer Wert macht jeden ausgegebenen
# Token ungueltig, der Desktop-Agent antwortet dann mit 401.
# KEEP this value across rebuilds — a new one invalidates every issued token.
JWT_SECRET=<ZUFALLSSTRING>

# --- Interne URLs / Internal URLs ---
# URL des Web-Containers (für Weiterleitungen nach OAuth)
# URL of the web container (for post-OAuth redirects)
FRONTEND_URL=https://<DEINE_DOMAIN>

# CORS-Origin der API (src/index.ts). PFLICHT: fehlt sie, erlaubt die API nur
# http://localhost:3000 und der Browser blockiert jede Anfrage von der echten
# Domain — die Web-App sieht dann eingeloggt aus, zieht aber keine Daten.
# CORS origin of the API. REQUIRED.
WEB_URL=https://<DEINE_DOMAIN>
